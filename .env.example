# Server Configuration
PORT=3000

# Session Signing Secret (recommended 32+ random hex chars in production)
SESSION_SECRET=

# Supabase Configuration (Optional - persistent local JSON store used if unset)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Razorpay Subscriptions & AutoPay Configuration (Required for live/test checkouts)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional Pre-Created Razorpay Monthly Plan IDs (auto-created via API if left blank)
RAZORPAY_PLAN_BASIC_ID=
RAZORPAY_PLAN_PRO_ID=
RAZORPAY_PLAN_PREMIUM_ID=
